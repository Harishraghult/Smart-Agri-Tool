    "stem_borer": {"display_name": "Stem / shoot borers", "kind": "pest",
      "management": ["Cut and destroy dead hearts, wilted shoots and bored stems", "Remove crop stubble after harvest", "Release Trichogramma egg parasitoids", "Apply a labelled systemic insecticide (e.g. chlorantraniliprole) at egg hatch"]},
    "planthopper_leafhopper": {"display_name": "Planthoppers / leafhoppers", "kind": "pest",
      "management": ["Avoid excess nitrogen fertiliser", "Drain fields periodically (rice) to reduce hopper build-up", "Use resistant varieties and light traps", "Spray a labelled insecticide (e.g. pymetrozine, buprofezin) at the base of plants"]},
    "aphid": {"display_name": "Aphids", "kind": "pest",
      "management": ["Spray neem oil or insecticidal soap on leaf undersides", "Encourage ladybirds and lacewings", "Remove heavily infested shoots", "For severe infestations use a labelled insecticide (e.g. imidacloprid, flonicamid)"]},
    "mite": {"display_name": "Mites", "kind": "pest",
      "management": ["Spray water or neem oil on leaf undersides", "Release predatory mites", "Avoid broad-spectrum insecticides that kill natural enemies", "Use a labelled miticide (e.g. abamectin, spiromesifen) for heavy infestations"]},
    "thrips": {"display_name": "Thrips", "kind": "pest",
      "management": ["Use blue sticky traps to monitor and trap", "Spray neem oil or spinosad", "Remove weeds that host thrips", "Rotate insecticide groups to avoid resistance"]},
    "whitefly": {"display_name": "Whiteflies", "kind": "pest",
      "management": ["Use yellow sticky traps", "Spray neem oil or insecticidal soap on leaf undersides", "Remove heavily infested leaves", "Use a labelled insecticide (e.g. pyriproxyfen, spirotetramat) for severe cases"]},
    "scale_mealybug": {"display_name": "Scale insects / mealybugs", "kind": "pest",
      "management": ["Prune and destroy heavily infested twigs", "Spray horticultural mineral oil in the dormant season", "Encourage ladybird beetles and parasitic wasps", "Control ants that protect scales and mealybugs"]},
    "fly_maggot": {"display_name": "Fruit flies / maggots / midges", "kind": "pest",
      "management": ["Collect and destroy fallen and infested fruit", "Use bait traps (e.g. methyl eugenol for fruit flies)", "Plough after harvest to expose pupae", "Use a labelled bait spray or insecticide at egg-laying time"]},
    "weevil": {"display_name": "Weevils", "kind": "pest",
      "management": ["Remove and destroy infested plant parts and fallen fruit", "Rotate crops and keep fields clean of residue", "Use a labelled insecticide when adults are active"]},
    "beetle": {"display_name": "Beetles / grubs", "kind": "pest",
      "management": ["Hand-pick adult beetles on small plots", "Plough to expose soil grubs to birds", "Use light traps for adults", "Apply a labelled insecticide or neem for heavy infestations"]},
    "grasshopper_cricket": {"display_name": "Grasshoppers / locusts / crickets", "kind": "pest",
      "management": ["Plough field edges to destroy egg pods", "Use poison bait (bran + labelled insecticide) for crickets", "Spray a labelled insecticide on young hoppers early"]},
    "plant_bug": {"display_name": "Plant bugs / stink bugs", "kind": "pest",
      "management": ["Remove weeds around the field", "Hand-collect bugs early in the morning", "Spray a labelled insecticide if damage is heavy"]},
    "slug_snail": {"display_name": "Slugs / snails", "kind": "pest",
      "management": ["Hand-pick at night or early morning", "Use beer traps or iron-phosphate bait", "Remove hiding places (boards, debris) near crops"]},
    "earwig": {"display_name": "Earwigs", "kind": "pest",
      "management": ["Set rolled-newspaper traps and empty them daily", "Remove debris where earwigs hide", "Usually minor: they also eat aphids"]},
    "ant": {"display_name": "Ants", "kind": "pest",
      "management": ["Ants often farm aphids and scales: control those pests too", "Use bait stations near nests", "Band tree trunks with sticky barriers"]},
    "wasp_bee": {"display_name": "Bees / wasps (mostly beneficial)", "kind": "beneficial",
